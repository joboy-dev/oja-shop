# Copy to .env.local and fill in. See PLAN.md §10 for where each value comes from.

# ── App ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=NGN

# ── Database: Neon Postgres ────────────────────────────────────────
# Pooled connection (host contains "-pooler") — used by the app at runtime
DATABASE_URL=
# Direct (unpooled) connection — used by drizzle-kit migrations
DATABASE_URL_UNPOOLED=

# ── Auth: Better Auth + Google OAuth ───────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google account emails promoted to admin on first sign-in
ADMIN_EMAILS=

# ── Email: Mailgun ─────────────────────────────────────────────────
MAILGUN_API_KEY=
# Verified sending domain, or sandbox domain (sandboxXXXX.mailgun.org)
MAILGUN_DOMAIN=
# https://api.mailgun.net (US region) or https://api.eu.mailgun.net (EU region)
MAILGUN_API_BASE_URL=https://api.mailgun.net
# Must be an address on MAILGUN_DOMAIN
MAIL_FROM="Ọjà <orders@your-domain.com>"
# Inbox that receives new-order and contact-form alerts
SHOP_NOTIFICATIONS_EMAIL=

# ── File storage: Neon Object Storage (S3-compatible, beta) ────────
# Fastest: run `neon env pull` — it writes the four AWS_* values for the branch.
# Or Neon Console → Connect → Storage tab → Reveal credential.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# Credential needs scopes storage:read + storage:write (server-only, never NEXT_PUBLIC_)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Name of your Neon bucket (access level: public read)
STORAGE_BUCKET=uploads
# Public HOST of the public_read bucket (no bucket name, no trailing slash); the app adds /<bucket>/<key>
# e.g. https://<branch-id>.storage.c-<N>.us-east-2.aws.neon.tech
STORAGE_PUBLIC_URL=

# ── Bank transfer details (optional) ───────────────────────────────
# Shown on the order page and in emails to customers who pay by transfer.
# Leave blank to say "we'll email our account details" instead.
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
